# Keep repository text portable across Windows, Linux containers, and deployment hosts.
* text=auto

# Source, configuration, and container files use LF.
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.env text eol=lf
*.example text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts remain native to Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf