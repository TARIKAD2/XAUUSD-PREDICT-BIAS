# Runtime environment
APP_NAME=AI Market Intelligence API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# MongoDB Atlas (leave empty until a database is provisioned)
MONGODB_URI=
DATABASE_NAME=ai_market_intelligence
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# External data providers (leave empty until provisioned)
TWELVE_DATA_API_KEY=
NEWS_API_KEY=
MARKETAUX_API_KEY=
ECONOMIC_DATA_API_KEY=
TRADING_ECONOMICS_API_KEY=
FINANCECALENDAR_ENABLED=true
FINANCECALENDAR_BASE_URL=https://www.financecalendar.com/wp-json/fc/v1
FRED_API_KEY=
BEA_API_KEY=
BLS_API_KEY=
EODHD_API_KEY=

# Application networking
NEXT_PUBLIC_API_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=15
# Model artifacts and optional closed-candle worker. Models are never baked
# into source control; mount or supply this directory at runtime.
MODELS_DIR=data/models
MARKET_INGESTION_ENABLED=false
MARKET_INGESTION_INTERVAL_SECONDS=3600
MARKET_INGESTION_LIMIT=300
MARKET_INGESTION_SYMBOLS=XAUUSD
MARKET_INGESTION_TIMEFRAME=1h
